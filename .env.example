# ═══════════════════════════════════════════════════
#  IoT IDS Platform — Environment Variables
# ═══════════════════════════════════════════════════

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://iot_admin:iot_secure_pass@postgres:5432/iot_ids
DATABASE_URL_SYNC=postgresql://iot_admin:iot_secure_pass@postgres:5432/iot_ids
POSTGRES_DB=iot_ids
POSTGRES_USER=iot_admin
POSTGRES_PASSWORD=iot_secure_pass

# ── Redis ────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT Auth ─────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-real-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Model Paths ──────────────────────────────────
MODEL_PATH=/app/models/cnn_lstm_global_with_HE_25rounds_16k.pt
SCALER_PATH=/app/models/standard_scaler.pkl
DEFAULT_THRESHOLD=0.5
SEQUENCE_LENGTH=10
NUM_FEATURES=78

# ── FL Server ────────────────────────────────────
FL_SERVER_HOST=fl_server
FL_SERVER_PORT=8080
FL_NUM_ROUNDS=25
FL_MIN_CLIENTS=2

# ── HE Parameters ───────────────────────────────
HE_SCHEME=ckks
HE_POLY_MODULUS=16384
HE_GLOBAL_SCALE=1099511627776

# ── App ──────────────────────────────────────────
APP_NAME=IoT IDS Platform
APP_VERSION=2.0.0
DEBUG=true
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ═══════════════════════════════════════════════════
#  Phase 2 — Security (mTLS + Gradient Signing)
# ═══════════════════════════════════════════════════
# Certificates are generated automatically by
# setup.sh (Linux/macOS) or setup.ps1 (Windows).
# All paths below are relative to the project root.

# ── FL Server — gRPC mTLS ────────────────────────
FL_TLS_CERT=./certs/server.crt
FL_TLS_KEY=./certs/server.key
FL_TLS_CA=./certs/ca.crt

# ── FL Server — client Ed25519 public keys dir ───
# The server reads <CLIENT_ID>.pub.pem files from
# this directory to verify per-round gradient sigs.
CLIENT_KEY_DIR=./certs/client_keys/

# ── FL Client — mTLS identity ────────────────────
# Defaults shown for Bank_A; docker_service.py and
# docker-compose.dev.yml override per container.
FL_CLIENT_CERT=./certs/Bank_A.crt
FL_CLIENT_KEY=./certs/Bank_A.key
FL_CA_CERT=./certs/ca.crt

# ── FL Client — gradient signing ─────────────────
# Ed25519 private key used to sign model updates.
CLIENT_SIGNING_KEY=./certs/Bank_A_ed25519.pem
